# Web app environment (copy to apps/web/.env.local; never commit real values). NEXT_PUBLIC_* are inlined at build time.

# API origin seen by the browser. Empty = same origin (dev rewrites to API_DEV_URL; production nginx).
NEXT_PUBLIC_API_URL=

# Server-side (not inlined): API for server components and the dev rewrites.
API_INTERNAL_URL=http://127.0.0.1:3038
API_DEV_URL=http://localhost:3038
