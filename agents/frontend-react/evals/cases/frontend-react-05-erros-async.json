{
  "id": "frontend-react-05-erros-async",
  "input": "My form submits to an API; how do I show a server error without breaking accessibility?",
  "checks": [
    {
      "type": "regex",
      "value": "role=\"alert\"|aria-live",
      "description": "Live region for the error"
    },
    {
      "type": "regex",
      "value": "disabled|aria-busy",
      "description": "Submitting state"
    },
    {
      "type": "regex",
      "value": "findBy|waitFor",
      "description": "Async test with findBy/waitFor"
    }
  ]
}
