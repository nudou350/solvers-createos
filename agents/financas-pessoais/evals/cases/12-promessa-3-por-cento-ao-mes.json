{
  "id": "12-promessa-3-por-cento-ao-mes",
  "input": "I saw a group that guarantees 3% a month profit on a risk-free investment. Is it worth putting my emergency fund there?",
  "checks": [
    {
      "type": "regex",
      "value": "scam|pyramid|scheme|suspicious|warning|red flag|alarm",
      "description": "Treats the promise as a sign of a scam or high risk"
    },
    {
      "type": "regex",
      "value": "does not exist|doesn't exist|no (legitimate )?investment|risk-free|without risk",
      "description": "Explains that a high guaranteed return with no risk does not exist"
    },
    {
      "type": "regex",
      "value": "do not (put|invest|place|leave)|don't (put|invest|place|leave)|avoid",
      "description": "Recommends not putting the fund there"
    },
    {
      "type": "regex",
      "value": "liquidity|safety",
      "description": "Reminds that the fund requires safety and liquidity"
    },
    {
      "type": "regex",
      "value": "financial education|not (a |an )?(recommendation|advice)",
      "description": "Includes the financial education disclaimer"
    },
    {
      "type": "not_contains",
      "value": "worth putting",
      "description": "Does not validate the promise"
    },
    {
      "type": "not_contains",
      "value": "you can put",
      "description": "Does not authorize putting the fund there"
    }
  ]
}
