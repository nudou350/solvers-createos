{
  "$description": "Token template from the Interface Design Solver (W3C DTCG format). Layers: primitives (color.gray, color.blue...), light-theme semantics (color.text, color.bg...) and component (button, input). The dark theme redefines only the semantic layer, in tokens.dark.json. Contrast verified with contrast_check on the backgrounds indicated. Draft DTCG format (color as hexadecimal, dimension as a string with unit), the most widely accepted by tools; the stable 2025.10 version uses objects for color and dimension and requires conversion.",
  "color": {
    "$type": "color",
    "white": { "$value": "#FFFFFF" },
    "gray": {
      "50": { "$value": "#F9FAFB" },
      "100": { "$value": "#F3F4F6" },
      "200": { "$value": "#E5E7EB" },
      "300": { "$value": "#D1D5DB" },
      "400": { "$value": "#9CA3AF", "$description": "Do not use as text on white (2.54:1). Safe as text on gray.900 (6.99:1)." },
      "500": { "$value": "#6B7280", "$description": "Lightest safe tone for text on white (4.83:1)." },
      "600": { "$value": "#4B5563" },
      "700": { "$value": "#374151" },
      "800": { "$value": "#1F2937" },
      "900": { "$value": "#111827" }
    },
    "blue": {
      "50": { "$value": "#EFF6FF" },
      "300": { "$value": "#93C5FD" },
      "400": { "$value": "#60A5FA" },
      "500": { "$value": "#3B82F6" },
      "600": { "$value": "#2563EB", "$description": "White on this tone: 5.17:1 (AA)." },
      "700": { "$value": "#1D4ED8" }
    },
    "red": {
      "50": { "$value": "#FEF2F2" },
      "400": { "$value": "#F87171" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" }
    },
    "green": {
      "50": { "$value": "#F0FDF4" },
      "400": { "$value": "#4ADE80" },
      "600": { "$value": "#16A34A", "$description": "White on this tone: 3.30:1. Large text only." },
      "700": { "$value": "#15803D" }
    },
    "amber": {
      "50": { "$value": "#FFFBEB" },
      "400": { "$value": "#FBBF24" },
      "700": { "$value": "#B45309" }
    },
    "text": {
      "default": { "$value": "{color.gray.900}", "$description": "Main text. 17.74:1 on bg.surface." },
      "subtle": { "$value": "{color.gray.600}", "$description": "Secondary and help text. 7.56:1 on bg.surface." },
      "disabled": { "$value": "{color.gray.400}", "$description": "Only for disabled components (exempt from contrast)." },
      "inverse": { "$value": "{color.white}", "$description": "Text on action.primary.bg and dark backgrounds." },
      "link": { "$value": "{color.blue.600}", "$description": "Links; always underlined in running text." }
    },
    "bg": {
      "canvas": { "$value": "{color.gray.50}", "$description": "Page background." },
      "surface": { "$value": "{color.white}", "$description": "Cards, forms, tables." },
      "surface-raised": { "$value": "{color.white}", "$description": "Menus and popovers (with shadow.md)." },
      "disabled": { "$value": "{color.gray.100}" }
    },
    "border": {
      "default": { "$value": "{color.gray.200}", "$description": "Decorative dividers. Do not use as the only border of an interactive component." },
      "input": { "$value": "{color.gray.500}", "$description": "Border for fields and controls. 4.83:1 on white (criterion 1.4.11 asks for 3:1)." },
      "focus": { "$value": "{color.blue.600}", "$description": "Focus ring. 5.17:1 on white." }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.blue.600}" },
        "bg-hover": { "$value": "{color.blue.700}" },
        "text": { "$value": "{color.white}" }
      }
    },
    "feedback": {
      "error": {
        "text": { "$value": "{color.red.700}", "$description": "6.47:1 on white; 5.91:1 on feedback.error.bg." },
        "bg": { "$value": "{color.red.50}" },
        "border": { "$value": "{color.red.600}" }
      },
      "success": {
        "text": { "$value": "{color.green.700}", "$description": "5.02:1 on white." },
        "bg": { "$value": "{color.green.50}" }
      },
      "warning": {
        "text": { "$value": "{color.amber.700}", "$description": "5.02:1 on white." },
        "bg": { "$value": "{color.amber.50}" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "inset": {
      "sm": { "$value": "{space.3}", "$description": "Padding for chips and small buttons." },
      "md": { "$value": "{space.4}", "$description": "Padding for buttons, fields and compact cards." },
      "lg": { "$value": "{space.6}", "$description": "Padding for cards and modals." }
    },
    "stack": {
      "xs": { "$value": "{space.2}", "$description": "Label to field." },
      "md": { "$value": "{space.4}", "$description": "Between fields in the same group." },
      "lg": { "$value": "{space.6}", "$description": "Between groups." },
      "xl": { "$value": "{space.8}", "$description": "Between sections." }
    },
    "inline": {
      "xs": { "$value": "{space.2}", "$description": "Icon to text." },
      "md": { "$value": "{space.4}", "$description": "Between buttons." }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "100": { "$value": "12px" },
      "200": { "$value": "14px" },
      "300": { "$value": "16px" },
      "400": { "$value": "18px" },
      "500": { "$value": "20px" },
      "600": { "$value": "24px" },
      "700": { "$value": "30px" },
      "800": { "$value": "36px" }
    }
  },
  "text": {
    "$type": "typography",
    "heading": {
      "lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.700}", "fontWeight": "{font.weight.bold}", "lineHeight": 1.2, "letterSpacing": "0px" } },
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.500}", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.4, "letterSpacing": "0px" } },
      "sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.300}", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.5, "letterSpacing": "0px" } }
    },
    "body": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.300}", "fontWeight": "{font.weight.regular}", "lineHeight": 1.5, "letterSpacing": "0px" } },
      "sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.200}", "fontWeight": "{font.weight.regular}", "lineHeight": 1.43, "letterSpacing": "0px" } }
    },
    "label": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.200}", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.43, "letterSpacing": "0px" } }
    },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.100}", "fontWeight": "{font.weight.regular}", "lineHeight": 1.33, "letterSpacing": "0px" } }
  },
  "shadow": {
    "$type": "shadow",
    "md": { "$value": { "color": "#1118271F", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" },
    "slow": { "$value": "300ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "enter": { "$value": [0, 0, 0.2, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] }
  },
  "button": {
    "primary": {
      "bg": { "$type": "color", "$value": "{color.action.primary.bg}" },
      "bg-hover": { "$type": "color", "$value": "{color.action.primary.bg-hover}" },
      "text": { "$type": "color", "$value": "{color.action.primary.text}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "48px" }
    },
    "radius": { "$type": "dimension", "$value": "{radius.md}" }
  },
  "input": {
    "border": {
      "$type": "color",
      "default": { "$value": "{color.border.input}" },
      "focus": { "$value": "{color.border.focus}" },
      "error": { "$value": "{color.feedback.error.border}" }
    },
    "height": { "$type": "dimension", "$value": "48px", "$description": "48px gives a comfortable target on mobile." }
  }
}
